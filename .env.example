# ---- Build / deploy ----------------------------------------------------------
# Base path for the build. "/" for https://ops-universe.github.io, "/repo-name/" for a project page.
BASE_PATH=/
# Canonical site URL used in meta tags (no trailing slash).
VITE_SITE_URL=https://ops-universe.github.io

# ---- GitHub data -------------------------------------------------------------
# Server-side ONLY. Used by `npm run snapshot` (Node) to raise the API rate limit
# while writing src/data/github-snapshot.json. It is never bundled into the client.
# Do NOT prefix it with VITE_ — anything prefixed VITE_ ships to the browser.
GITHUB_TOKEN=

# Optional: point the browser at your own server-side proxy (one that adds a token)
# instead of api.github.com. Leave empty to call the public API unauthenticated.
VITE_GITHUB_API_BASE=
